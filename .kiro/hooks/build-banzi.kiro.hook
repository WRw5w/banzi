{
  "enabled": true,
  "name": "▶ 编译板子",
  "description": "手动点击触发，连续两次编译唯一正式大版本",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "xelatex -synctex=1 -interaction=nonstopmode -file-line-error -output-directory banzi \"banzi/板子_大版本.tex\" && xelatex -synctex=1 -interaction=nonstopmode -file-line-error -output-directory banzi \"banzi/板子_大版本.tex\""
  }
}
